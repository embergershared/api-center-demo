{
  "openapi": "3.0.1",
  "info": {
    "title": "Fleet Vehicle API (az apic)",
    "version": "2.0.0",
    "description": "A sample API for managing an electrified fleet — vehicles, battery state, and depot charging sessions. Version 2 — adds pagination, vehicle operational status, and structured errors."
  },
  "paths": {
    "/vehicles": {
      "get": {
        "summary": "List all fleet vehicles",
        "description": "Returns a paged list of electric vehicles in the fleet, with cursor-based pagination.",
        "operationId": "listVehicles",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 }, "description": "Max number of results to return" },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Pagination cursor from a previous response" },
          { "name": "fleetGroup", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Filter vehicles by fleet group/depot" }
        ],
        "responses": {
          "200": {
            "description": "A page of vehicles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/Vehicle" } },
                    "nextCursor": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register a vehicle",
        "description": "Adds a new electric vehicle to the fleet inventory.",
        "operationId": "createVehicle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Vehicle" } }
          }
        },
        "responses": {
          "201": { "description": "Vehicle created" },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/vehicles/{vehicleId}": {
      "get": {
        "summary": "Get a vehicle by ID",
        "description": "Returns a single vehicle's details, including operational status.",
        "operationId": "getVehicleById",
        "parameters": [
          { "name": "vehicleId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "The vehicle's unique identifier" }
        ],
        "responses": {
          "200": {
            "description": "The requested vehicle",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Vehicle" } }
            }
          },
          "404": { "description": "Vehicle not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/vehicles/{vehicleId}/battery": {
      "get": {
        "summary": "Get battery state for a vehicle",
        "description": "Returns the current state of charge, health, and estimated range for a vehicle.",
        "operationId": "getVehicleBattery",
        "parameters": [
          { "name": "vehicleId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "The vehicle's unique identifier" }
        ],
        "responses": {
          "200": {
            "description": "Battery state",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/BatteryState" } }
            }
          },
          "404": { "description": "Vehicle not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/depots/{depotId}/charging-sessions": {
      "get": {
        "summary": "List charging sessions at a depot",
        "description": "Returns charging sessions recorded at a depot's chargers, ordered by start time.",
        "operationId": "listDepotChargingSessions",
        "parameters": [
          { "name": "depotId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "The depot's unique identifier" },
          { "name": "startDate", "in": "query", "required": false, "schema": { "type": "string", "format": "date" }, "description": "Filter sessions starting on or after this date" },
          { "name": "endDate", "in": "query", "required": false, "schema": { "type": "string", "format": "date" }, "description": "Filter sessions starting on or before this date" }
        ],
        "responses": {
          "200": {
            "description": "A list of charging sessions",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ChargingSession" } }
              }
            }
          },
          "404": { "description": "Depot not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Vehicle": {
        "type": "object",
        "required": ["id", "vin", "fleetGroup", "status"],
        "properties": {
          "id": { "type": "string", "description": "Unique identifier for the vehicle" },
          "vin": { "type": "string", "description": "Vehicle identification number" },
          "make": { "type": "string", "description": "Vehicle manufacturer" },
          "model": { "type": "string", "description": "Vehicle model" },
          "fleetGroup": { "type": "string", "description": "Fleet grouping/depot the vehicle is assigned to" },
          "status": { "type": "string", "enum": ["in-service", "charging", "maintenance", "decommissioned"], "description": "Current operational status" }
        }
      },
      "BatteryState": {
        "type": "object",
        "required": ["stateOfChargePercent"],
        "properties": {
          "stateOfChargePercent": { "type": "number", "description": "Current state of charge, 0-100" },
          "stateOfHealthPercent": { "type": "number", "description": "Battery health relative to original capacity, 0-100" },
          "rangeKm": { "type": "number", "description": "Estimated remaining range in kilometers" }
        }
      },
      "ChargingSession": {
        "type": "object",
        "required": ["sessionId", "vehicleId", "startTime", "energyDeliveredKwh"],
        "properties": {
          "sessionId": { "type": "string", "description": "Unique identifier for the charging session" },
          "vehicleId": { "type": "string", "description": "The vehicle that was charged" },
          "chargerId": { "type": "string", "description": "The depot charger used" },
          "startTime": { "type": "string", "format": "date-time", "description": "When the charging session began" },
          "endTime": { "type": "string", "format": "date-time", "description": "When the charging session ended" },
          "energyDeliveredKwh": { "type": "number", "description": "Energy delivered during the session, in kWh" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "description": "Machine-readable error code" },
          "message": { "type": "string", "description": "Human-readable error message" }
        }
      }
    }
  }
}
